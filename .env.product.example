# Local product development only. npm run dev copies this file to
# .env.product.local on first run and never overwrites an existing file.
# Leave DATABASE_URL empty to let npm run dev start the isolated Docker database.
# Set it only to use an external, disposable development database; npm run dev
# will not start Docker or run migrations against an explicit DATABASE_URL.
DATABASE_URL=
# Optional host port for the isolated Docker database (default: 55432).
DEV_DATABASE_PORT=55432
# Default local port for the Next.js panel
NEXT_DEV_PORT=3000
# Fastify API port; localhost only
APP_PORT=3109
