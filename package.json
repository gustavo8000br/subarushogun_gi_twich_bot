{
  "name": "subarushogun-gi-twitch-queue-bot",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build": "docker compose -f compose.yaml -f compose.build.yaml build bot",
    "dev": "node apps/frontend/scripts/dev-server.mjs",
    "dev:db:start": "node apps/frontend/scripts/dev-database-command.mjs start",
    "dev:db:stop": "node apps/frontend/scripts/dev-database-command.mjs stop",
    "sync:ide": "node .aiox-core/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:check": "node .aiox-core/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync:skills:codex": "node .aiox-core/infrastructure/scripts/codex-skills-sync/index.js",
    "test:e2e:overlay": "node tests/e2e/overlay-browser.mjs",
    "test:e2e:overlay:browser-only": "node tests/e2e/overlay-browser-only.mjs",
    "build:frontend": "next build apps/frontend",
    "validate:version": "node apps/infra/scripts/validate-version.mjs",
    "validate:port-denylist": "node apps/infra/scripts/validate-port-denylist.mjs",
    "validate:localization": "node apps/infra/scripts/validate-localization.mjs",
    "materialize:version": "node apps/infra/scripts/materialize-version.mjs",
    "installer:package": "node apps/infra/scripts/package-installer.mjs",
    "infra:bootstrap": "node apps/infra/scripts/bootstrap.mjs",
    "lint": "eslint apps tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "lint:api": "eslint apps/api --max-warnings=0",
    "lint:infra": "eslint apps/infra --max-warnings=0",
    "lint:web": "eslint apps/web --max-warnings=0",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:infra": "tsc --noEmit -p tsconfig.infra.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "review:static": "opengrep scan --config .opengrep/rules.yml --no-git-ignore --error --exclude=apps/frontend/.next --exclude=apps/frontend/out apps"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0",
    "fastify": "5.12.5",
    "js-yaml": "5.4.3",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.1",
    "prisma": "6.19.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
