{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/**/*.js",
    "apps/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "apps/frontend/.next",
    "apps/frontend/out"
  ]
}
